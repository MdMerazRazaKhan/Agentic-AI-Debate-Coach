# =========================================================================
# LOGOS.AI - Configuration Settings
# =========================================================================

# General
PROJECT_NAME="LOGOS.AI - Agentic Debate Coach & Presentation Analysis Platform"
SECRET_KEY="logos-ai-super-secret-key-2026-rhetoric-intelligence"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Primary Relational DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=logos_ai_db
DATABASE_URL=postgresql://postgres:postgrespassword2026@localhost:5432/logos_ai_db

# MongoDB Secondary Document Store DB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logos_ai_transcripts

# External LLM Engine API Keys (Optional - built-in local fallback activates if unset)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com
