# =========================================================================
# Dockerfile for Frontend Client (Next.js Production Build)
# =========================================================================
FROM node:18-alpine

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Install dependencies
COPY frontend/package*.json ./
RUN npm install

# Copy source code and build production assets
COPY frontend ./
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start"]
